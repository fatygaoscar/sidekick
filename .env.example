# Sidekick Configuration
# Copy this file to .env and fill in your values.
# After editing .env, run ./restart.sh to pick up changes.
# (get_settings() is LRU-cached — a live reload is not enough.)

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/sidekick.db

# ── Transcription ─────────────────────────────────────────────────────────────
# Backend: "local" (WhisperX, runs on your GPU) or "openai" (cloud API)
TRANSCRIPTION_BACKEND=local

# WhisperX local settings — only used when TRANSCRIPTION_BACKEND=local
# Model sizes: tiny | base | small | medium | large-v2 | large-v3
# large-v3 is strongly recommended for production quality.
WHISPER_MODEL_SIZE=large-v3
# Device: cuda | cpu | auto  (auto detects CUDA; use cuda explicitly if available)
WHISPER_DEVICE=cuda
# Compute type: float16 | int8 | float32 | auto  (float16 is optimal for CUDA)
WHISPER_COMPUTE_TYPE=float16
WHISPERX_BATCH_SIZE=16

# OpenAI API key — required only when TRANSCRIPTION_BACKEND=openai
OPENAI_API_KEY=

# ── Summarization ─────────────────────────────────────────────────────────────
# Backend: "ollama" (local LLM) | "openai" | "anthropic"
SUMMARIZATION_BACKEND=ollama
# Timeout in seconds for a single LLM call (0 = no timeout)
SUMMARIZATION_TIMEOUT_SECONDS=300
# Shared summarization context budget used by the cohesive summarizer across providers.
SUMMARIZATION_CONTEXT_LENGTH=32768
# Legacy feature flag for the deprecated structured meeting summarizer.
# Normal meeting summaries now use the cohesive two-pass summarizer.
SUMMARIZATION_MEETING_STRUCTURED_ENABLED=false

# Ollama settings — used when SUMMARIZATION_BACKEND=ollama
# Sidekick runs in WSL; Ollama runs on Windows host.
# With WSL mirrored networking (see docs/HOST_OLLAMA_SETUP.md), 127.0.0.1 works directly.
OLLAMA_HOST=http://127.0.0.1:11434
# Model to use. qwen3:8b is the recommended default for 16 GB VRAM systems.
# Pull from Windows PowerShell: ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b
# Context window size. 32768 fits qwen3:8b + KV cache 100% in 16 GB VRAM.
# Supports ~2.5 hours of speech. Reduce to 16384 if you have less VRAM.
OLLAMA_CONTEXT_LENGTH=32768
# Disable chain-of-thought thinking mode (only effective for qwen3 models, not qwen3.5).
# Leaving this false saves 3000-5000 wasted tokens per call.
OLLAMA_THINK=false
# Force all model layers to GPU. Ollama's auto-estimate conservatively offloads
# a few layers to CPU; setting 99 overrides this and roughly doubles throughput.
OLLAMA_NUM_GPU=99

# OpenAI summarization model (used when SUMMARIZATION_BACKEND=openai)
OPENAI_SUMMARIZATION_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RETRIES=2
OPENAI_SUMMARIZATION_TEMPERATURE=0.2
OPENAI_SUMMARIZATION_MAX_OUTPUT_TOKENS=4096

# Anthropic API key and model (used when SUMMARIZATION_BACKEND=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_SUMMARIZATION_MODEL=claude-3-haiku-20240307

# ── Speaker Diarization ───────────────────────────────────────────────────────
# Identifies who spoke when. Requires a free HuggingFace account.
# Step 1: Accept license at https://hf.co/pyannote/speaker-diarization-3.1
#         and https://hf.co/pyannote/segmentation-3.0
# Step 2: Generate a read token at https://huggingface.co/settings/tokens
# Step 3: Paste token below and set DIARIZATION_ENABLED=true
HF_TOKEN=
DIARIZATION_ENABLED=false

# ── Obsidian Export ───────────────────────────────────────────────────────────
# Absolute path to your Obsidian vault. Exports write .md files here directly.
# WSL example: /mnt/c/Users/YourName/Documents/Obsidian Vault
OBSIDIAN_VAULT_PATH=/mnt/c/Users/YourName/Documents/Obsidian Vault

# ── Audio ─────────────────────────────────────────────────────────────────────
# Audio is captured at 48 kHz for playback quality and downsampled to 16 kHz for AI.
# These settings rarely need to change.
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
VAD_AGGRESSIVENESS=2
# Show live transcription preview text while recording (requires more GPU)
LIVE_TRANSCRIPTION_PREVIEW=true
# Seconds to flag after an Important Marker button press
IMPORTANT_MARKER_DURATION=60
